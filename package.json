{
  "name": "skillsm",
  "version": "0.1.0",
  "description": "Sync your Git-hosted skills repository to your AI tools.",
  "type": "module",
  "bin": {
    "skillsm": "bin/skillsm.js"
  },
  "files": [
    "bin/",
    "src/",
    "docs/skillsm.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check bin/skillsm.js && node --check src/cli.js && node --check src/store.js && node --check src/repository.js && node --check src/install.js",
    "prepublishOnly": "npm run check && npm test"
  },
  "engines": {
    "node": "^22.13.0 || >=23.5.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "yaml": "^2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boltguo/skillsm.git"
  },
  "homepage": "https://github.com/boltguo/skillsm#readme",
  "bugs": {
    "url": "https://github.com/boltguo/skillsm/issues"
  },
  "keywords": [
    "agent-skills",
    "skills",
    "codex",
    "claude",
    "antigravity",
    "cli"
  ],
  "license": "Apache-2.0"
}
